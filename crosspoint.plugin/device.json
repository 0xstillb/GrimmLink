{
  "title": "GrimmLink",
  "description": "Browse Grimmory Regular and Magic Shelves on CrossPoint (EPUB only)",
  "config": {
    "file": "config.json"
  },
  "browse": {
    "format": "xml",
    "url": "{cfg.server}/api/grimmlink/v1/shelves/crosspoint.xml",
    "method": "GET",
    "headers": {
      "x-auth-user": "{cfg.username}",
      "x-auth-key": "{cfg.auth_key}",
      "Accept": "application/xml"
    },
    "item": "entry",
    "container_element": "collection",
    "skip_self": true,
    "resolve_urls": true,
    "fields": {
      "title": "title",
      "author": "author",
      "id": "id",
      "url": "url"
    }
  },
  "download": {
    "headers": {
      "x-auth-user": "{cfg.username}",
      "x-auth-key": "{cfg.auth_key}"
    },
    "dest_dir": "/GrimmLink",
    "filename": "{title}.epub",
    "sidecar": {
      "path": "{dest}.meta.json",
      "body": "{\"grimmory_id\":{id},\"source\":\"grimmlink\",\"format\":\"epub\"}"
    }
  }
}
